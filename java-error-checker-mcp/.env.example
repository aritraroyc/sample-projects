# Java Error Checker MCP Service Configuration

# Workspace directory for Java projects
JDTLS_WORKSPACE_DIR=/tmp/jdtls-workspaces

# Session timeout in seconds (1 hour = 3600)
SESSION_TIMEOUT=3600

# JDTLS installation path (optional, falls back to javac if not set)
JDTLS_PATH=/opt/jdtls

# Java home directory (optional, auto-detected if not set)
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# JDTLS memory allocation
JDTLS_MEMORY=1G

# Logging configuration
LOG_FILE=/tmp/java-error-checker-mcp.log
LOG_LEVEL=INFO
